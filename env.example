# Application Configuration
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Database Configuration
# For local development (adjust as needed)
DATABASE_URL="postgresql://username:password@localhost:5432/atomic_ambitions_dev"

# For production (example with managed database)
# DATABASE_URL="postgresql://username:password@your-db-instance.region.rds.amazonaws.com:5432/atomic_ambitions_prod?sslmode=require&pool_size=10"

# Optional: Additional database settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Other environment variables (add as needed)
# JWT_SECRET=your-jwt-secret-here
# RESEND_API_KEY=your-resend-api-key-here
